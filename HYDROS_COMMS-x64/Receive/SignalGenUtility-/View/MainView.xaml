<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:SciChart="http://schemas.abtsoftware.co.uk/scichart"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:DelsysSigNIalGen.ViewModel"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sciChart="http://schemas.abtsoftware.co.uk/scichart"
        xmlns:plots="clr-namespace:Plotter.View.Plots;assembly=Delsys.Plotter" xmlns:sci="http://schemas.abtsoftware.co.uk/scichart"
        x:Class="DelsysSigNIalGen.View.MainView"
        d:DataContext="{d:DesignInstance Type={x:Type viewmodel:MainViewModel}}"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="1101" Width="1900">
    <!--Height="1356" Width="1140">-->
    <Window.Resources>
        <ResourceDictionary>
            <viewmodel:BooleanInverterAndVisibilityConverter x:Key="BooleanInverterAndVisibilityConverter" />
            <Style x:Key="Caption"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Title>
        <StaticResource ResourceKey="AppTitle"/>
    </Window.Title>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--<ColumnDefinition Width="1*" MaxWidth="300"/>
            <ColumnDefinition Width="2*"/>-->
            <ColumnDefinition Width="1*" MaxWidth="300"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Margin="0,0,0,5">
            <StackPanel Grid.Column="0" Margin="10">
                <materialDesign:Card Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="10"
                               Foreground="White"
                               Text="HYDROS Dev. App"
                               />
                        <StackPanel Orientation="Horizontal" Margin="0" HorizontalAlignment="Center" >
                            <TextBox materialDesign:HintAssist.Hint="Samples to Keep in Memory" 
             Style="{StaticResource MaterialDesignFilledTextBox}"
             Margin="0"
             Foreground="White"
             Text="{Binding SamplesInMemory, StringFormat='{}{0:0,0}'}"
             materialDesign:HintAssist.Foreground="White" Width="240"/>
                        </StackPanel>
                        <!--OutputLog Below-->
                        <!--Carrier Frequency-->
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <TextBox materialDesign:HintAssist.Hint="Carrier Frequency"
                         Text="{Binding SecretCarrierFrequency, StringFormat='{}{0:0,0}', Mode=TwoWay}"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         Margin="10"
                         Foreground="White"
                         materialDesign:HintAssist.Foreground="White"
                         Width="150"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card  
                Margin="0,10,0,10"
                Visibility="{Binding IsFromFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"/>
                        <ComboBox Grid.Column="1" Margin="10" x:Name="analogInChannel"
                               materialDesign:HintAssist.Hint="Channel "
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="140"
                                      SelectedIndex="0"
                                      SelectedValue="{Binding AnalogInChannel}"
                                  ItemsSource="{Binding AI_Names}"
                                  Foreground="White"
                                      IsEnabled="{Binding IsAnalogInNotRunning}"
                          />
                        <Button Content="Start" Command="{Binding ListenDecodeCommand}" Margin="10"/>
                        <Button Content="Stop" 
                                Command="{Binding StopNICardCommand}" Margin="10" IsEnabled="{Binding IsAnalogInRunning}"/>

                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="1" Margin="10">
            <materialDesign:Card Margin="10" 
                                 Height="auto"
                                 Width="auto"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="10"
                               Foreground="White"
                               Text="Acoustic waveform in Time Domain"
                                   Grid.Row="0"
                               FontSize="25"
                               />
                    <plots:SingleSurfacePlot x:Name="PlotContainer" 
                                                DataContext="{Binding PlotViewModel}" 
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         Margin="10"
                                                                          Grid.Row="1"

                                         >
                    </plots:SingleSurfacePlot>
                </Grid>
            </materialDesign:Card>
        </Grid>
        <!--ADDING SECOND SURFACE-->
        <Grid Grid.Column="2" Margin="10">
            <materialDesign:Card Margin="10" Height="auto" Width="auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <!-- Container for the two vertically stacked plots -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="10"
                               Foreground="CadetBlue"
                               Text="Heart Rate"
                                   Grid.Row="0"
                                   FontSize="25"
                               />
                    <!-- First new plot -->
                    <sciChart:SciChartSurface x:Name="LinePlotSurface1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" Grid.Row="1">
                        <sciChart:SciChartSurface.Annotations>
                            <sciChart:TextAnnotation X1="5" Y1="0.5" 
                          Text="Sample Annotation"
                          FontSize="16"
                          Foreground="CadetBlue"
                          HorizontalAnchorPoint="Left"
                          VerticalAnchorPoint="Center"/>
                        </sciChart:SciChartSurface.Annotations>
                        <sciChart:SciChartSurface.GridLinesPanelStyle>
                            <Style TargetType="sciChart:GridLinesPanel">
                                <Setter Property="Padding" Value="20" />
                            </Style>
                        </sciChart:SciChartSurface.GridLinesPanelStyle>

                        <sciChart:SciChartSurface.XAxis>
                            <SciChart:NumericAxis AxisAlignment="Bottom" AxisTitle="Time" AutoRange="Always" />
                        </sciChart:SciChartSurface.XAxis>
                        <sciChart:SciChartSurface.YAxis>
                            <SciChart:NumericAxis AxisAlignment="Right" AxisTitle="HR (bpm)" AutoRange="Never" VisibleRange="35, 200"/>
                        </sciChart:SciChartSurface.YAxis>

                        <sciChart:SciChartSurface.RenderableSeries>
                            <!-- Add your line series here -->
                            <sciChart:FastLineRenderableSeries x:Name="LineRenderableSeries1" Stroke="CadetBlue" StrokeThickness="3">
                                <sciChart:FastLineRenderableSeries.PointMarker>
                                    <sciChart:EllipsePointMarker Width="8" Height="8" Fill="CadetBlue"/>
                                </sciChart:FastLineRenderableSeries.PointMarker>
                            </sciChart:FastLineRenderableSeries>
                        </sciChart:SciChartSurface.RenderableSeries>

                    </sciChart:SciChartSurface>

                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="10"
                               Foreground="CadetBlue"
                               Text="SPO2:"
                                   Grid.Row="2"
                               FontSize="25"
                               />
                    <!-- Second new plot -->

                    <sciChart:SciChartSurface x:Name="LinePlotSurface2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" Grid.Row="4">
                        <sciChart:SciChartSurface.GridLinesPanelStyle>
                            <Style TargetType="sciChart:GridLinesPanel">
                                <Setter Property="Padding" Value="20" />
                            </Style>
                        </sciChart:SciChartSurface.GridLinesPanelStyle>

                        <sciChart:SciChartSurface.XAxis>
                            <SciChart:NumericAxis AxisAlignment="Bottom" AxisTitle="Time" AutoRange="Always" />
                        </sciChart:SciChartSurface.XAxis>
                        <sciChart:SciChartSurface.YAxis>
                            <SciChart:NumericAxis AxisAlignment="Right" AxisTitle="SPO2 (%)" AutoRange="Never" VisibleRange="70, 105" />
                        </sciChart:SciChartSurface.YAxis>

                        <sciChart:SciChartSurface.RenderableSeries>
                            <!-- Add your line series here -->
                            <sciChart:FastLineRenderableSeries x:Name="LineRenderableSeries2" Stroke="CadetBlue" StrokeThickness="3">
                                <sciChart:FastLineRenderableSeries.PointMarker>
                                    <sciChart:EllipsePointMarker Width="8" Height="8" Fill="CadetBlue"/>
                                </sciChart:FastLineRenderableSeries.PointMarker>
                            </sciChart:FastLineRenderableSeries>
                        </sciChart:SciChartSurface.RenderableSeries>
                    </sciChart:SciChartSurface>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
