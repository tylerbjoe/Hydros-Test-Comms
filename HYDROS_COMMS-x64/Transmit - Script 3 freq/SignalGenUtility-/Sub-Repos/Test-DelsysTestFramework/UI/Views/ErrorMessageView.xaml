<Window x:Class="DelsysTestLib.UI.Views.ErrorMessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DelsysTestLib.UI.Views"
        mc:Ignorable="d"
        Title="Error Message" Height="265" Width="250"
        ResizeMode="NoResize"
        Background="#222f34"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="0,0,0,1">
        <TextBlock x:Name="textBlock" 
                   HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" 
                   VerticalAlignment="Top" 
                   TextAlignment="Center"
                   Height="149" Width="208" FontSize="20" FontWeight="Bold" Text="" Foreground="White"></TextBlock>
        <Button x:Name="Button1" Content="Ok" HorizontalAlignment="Center" 
                Margin="0,0,0,20" VerticalAlignment="Bottom" Height="50" Width="80" Click="Button_Click"/>

    </Grid>
</Window>
