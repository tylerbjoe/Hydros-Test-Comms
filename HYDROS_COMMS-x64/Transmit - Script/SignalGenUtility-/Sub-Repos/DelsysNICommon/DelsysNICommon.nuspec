<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
	<metadata>
        <id>DelsysNICommon</id>
		<version>1.0.0.0</version>
        <description>Library to interact with NI and Base Station Tester.</description>
		<authors>Delsys</authors>
		<owners>Delsys</owners>
		<dependencies>
			<group targetFramework="net8.0"></group>
		</dependencies>
		<contentFiles>
			<!-- This unpacks any extra content files like debug files -->
			<files include="DelsysNICommon\References\**" buildAction="None" copyToOutput="true" flatten="false"/>
		</contentFiles>
    </metadata> 
	<files>
		<file src="DelsysNICommon\bin\x86\Release\net8.0\DelsysNICommon.dll"
			target="lib\net8.0\DelsysNICommon_32.dll" />
		<file src="DelsysNICommon\bin\x64\Release\net8.0\DelsysNICommon.dll"
			target="lib\net8.0\DelsysNICommon_64.dll" />
		<file src=".\References\**"
			target="lib\net8.0" />
	</files>
</package>